# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only - never ship to web/native

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=            # any random string, you invent it

# ---- ImageKit ----
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yourid
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=               # server only

# ---- Admin dashboard write auth ----
ADMIN_API_KEY=                      # any long random string, you invent it

# ---- Local scripts only (not needed by the Worker) ----
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
