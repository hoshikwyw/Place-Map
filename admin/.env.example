# The deployed Worker, no trailing slash. Use http://localhost:8787 in dev.
PLACE_MAP_API_URL="https://place-map-api.YOURNAME.workers.dev"

# Must match the Worker's ADMIN_API_KEY secret. Server-side only - it is never
# sent to the browser.
ADMIN_API_KEY=""

# The password you type to sign in.
ADMIN_PASSWORD=""

# Signs the session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=""

# Needed only for image uploads (the dashboard resizes and uploads server-side).
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/yourid"
IMAGEKIT_PRIVATE_KEY=""
