{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "buildCommand": "pnpm build:vercel && mkdir -p public",

  "outputDirectory": "public",

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "crons": [{ "path": "/internal/keepalive", "schedule": "0 6 * * *" }]
}
