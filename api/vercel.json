{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "buildCommand": "pnpm build:vercel",

  "outputDirectory": "public",

  "functions": {
    "api/index.js": {
      "includeFiles": "bundle/**"
    }
  },

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "crons": [{ "path": "/internal/keepalive", "schedule": "0 6 * * *" }]
}
