# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* values into the bundle,
# so never put a secret here - anyone with the app can read them.

# The API Worker, no trailing slash.
# On a real phone "localhost" is the phone itself: use the deployed Worker URL,
# or your computer's LAN address while running `pnpm dev` (e.g. http://192.168.1.20:8787).
EXPO_PUBLIC_API_URL=https://place-map-api.YOURNAME.workers.dev

# The places' own time zone. "Open now" is judged in this zone, not the phone's.
EXPO_PUBLIC_TIME_ZONE=Asia/Tashkent
