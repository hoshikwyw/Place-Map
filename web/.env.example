# The deployed Worker, no trailing slash. http://localhost:8787 in dev.
# Read on the server only - the browser never calls the API directly.
PLACE_MAP_API_URL="https://place-map-api.YOURNAME.workers.dev"

# Canonical origin for sitemap, canonical links and Open Graph URLs.
# Falls back to Vercel's production URL when unset.
SITE_URL="https://your-domain.example"

# The zone the places are in. "Open now" is evaluated here, not in the
# server's UTC or the visitor's own zone.
TIMEZONE="Asia/Tashkent"

# Optional. Any MapLibre style URL; the default is OpenFreeMap, which needs no
# key and no account.
NEXT_PUBLIC_MAP_STYLE="https://tiles.openfreemap.org/styles/liberty"
